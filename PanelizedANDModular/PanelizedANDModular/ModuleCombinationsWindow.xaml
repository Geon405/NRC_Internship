<Window x:Class="PanelizedAndModularFinal.ModuleCombinationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Module Combinations" Height="400" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Area info -->
            <RowDefinition Height="*"/>
            <!-- ListBox -->
            <RowDefinition Height="Auto"/>
            <!-- OK button -->
        </Grid.RowDefinitions>

        <Label x:Name="lblAreaInfo"
           Grid.Row="0"
           Content="Minimum Area: 0 ft², Maximum Area: 0 ft²"
           Margin="0,0,0,10"/>

        <ListBox x:Name="lbCombinations"
             Grid.Row="1"
             Margin="0,0,0,10"
             FontFamily="Consolas"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton"
              Content="OK"
              Width="80"
              Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>